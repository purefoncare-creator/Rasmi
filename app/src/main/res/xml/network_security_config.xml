        <!-- ── Asia-Pacific ── -->
        <!-- India -->
        <domain includeSubdomains="true">mmsc.airtel.in</domain>
        <domain includeSubdomains="true">mms.jio.com</domain>
        <domain includeSubdomains="true">mmsc.vodafone.in</domain>
        <domain includeSubdomains="true">mmsc.idea.net.in</domain>
        <domain includeSubdomains="true">mmsc.bsnl.co.in</domain>
        <!-- China -->
        <domain includeSubdomains="true">mmsc.monternet.com</domain>
        <domain includeSubdomains="true">mmsc.myuni.com.cn</domain>
        <domain includeSubdomains="true">mmsc.chinatelecom.cn</domain>
        <!-- Japan -->
        <domain includeSubdomains="true">mms.softbank.ne.jp</domain>
        <domain includeSubdomains="true">mms.au.kddi.com</domain>
        <!-- South Korea -->
        <domain includeSubdomains="true">mms.skt.com</domain>
        <domain includeSubdomains="true">mms.lguplus.co.kr</domain>
        <!-- Indonesia -->
        <domain includeSubdomains="true">mms.telkomsel.com</domain>
        <domain includeSubdomains="true">mms.xl.co.id</domain>
        <!-- Pakistan -->
        <domain includeSubdomains="true">mms.jazz.com.pk</domain>
        <domain includeSubdomains="true">mms.telenor.com.pk</domain>
        <!-- Malaysia -->
        <domain includeSubdomains="true">mms.maxis.com.my</domain>
        <domain includeSubdomains="true">mms.celcom.com.my</domain>
        <!-- Australia -->
        <domain includeSubdomains="true">mmsc.telstra.com</domain>
        <domain includeSubdomains="true">mmsc.optus.com.au</domain>

        <!-- ── Africa ── -->
        <domain includeSubdomains="true">mms.mtn.com</domain>
        <domain includeSubdomains="true">mms.vodacom.co.za</domain>
        <domain includeSubdomains="true">mms.safaricom.co.ke</domain>
        <domain includeSubdomains="true">mms.airtel.com</domain>

        <!-- ── Latin America ── -->
        <domain includeSubdomains="true">mms.claro.com.br</domain>
        <domain includeSubdomains="true">mms.tim.com.br</domain>
        <domain includeSubdomains="true">mms.claro.com.mx</domain>
        <domain includeSubdomains="true">mms.telcel.com</domain>
        <domain includeSubdomains="true">mms.movistar.com</domain>

        <!-- Generic wildcard patterns removed — specific carrier domains above are sufficient.
             Broad patterns like "mms" or "mmsc" without a TLD allow cleartext to any
             subdomain (e.g. evil.mms.attacker.com), creating a MITM attack surface. -->
    </domain-config>
</network-security-config>
